# Canonical site URL (used for SEO, RSS, OG tags, sitemap, and canonical links).
# Must be absolute http(s) with a host; a trailing slash is stripped.
# It also decides whether the admin session cookie is marked Secure — an http://
# value (a local dev run) turns that off so login works over plain HTTP.
DTCOM_BASE_URL=https://davidtorcivia.com

# Admin password as a bcrypt hash. Generate with:
#   htpasswd -BbnC 10 "" "yourpassword" | cut -d: -f2
# (the hash must start with $2a$, $2b$, or $2y$ — the app refuses to start
# otherwise, so a plaintext password can't be pasted in by mistake)
DTCOM_ADMIN_PASSWORD_HASH=

# TOTP shared secret (base32, at least 16 characters). Generate a 20-byte
# secret and base32-encode it, e.g.:
#   python3 -c "import base64,os;print(base64.b32encode(os.urandom(20)).decode())"
# Add it to your authenticator app (Google Authenticator, 1Password, etc.) as a
# TOTP key — the label doesn't matter, just the secret.
DTCOM_TOTP_SECRET=

# HMAC key for signing admin session cookies (at least 32 characters).
# It also salts the one-way IP hashes in the views table.
# Generate with: openssl rand -hex 32
DTCOM_SESSION_KEY=

# Bearer token for the REST API (/api/v1/*) and MCP server (/mcp).
# At least 24 characters. Generate with: openssl rand -hex 24
DTCOM_API_TOKEN=

# RSS poller interval (Go duration syntax). Minimum 1m, default 30m.
DTCOM_RSS_INTERVAL=30m

# --- optional ---------------------------------------------------------------

# Read the client address from CF-Connecting-IP / X-Forwarded-For. Set this
# ONLY when a reverse proxy sits in front (Cloudflare Tunnel, nginx, Caddy).
# With the port exposed directly, a client could forge these headers to inflate
# view counts and slip past the login rate limiter.
# DTCOM_TRUST_PROXY=true

# Force the session cookie's Secure flag instead of deriving it from
# DTCOM_BASE_URL's scheme. Only useful when TLS terminates upstream of an
# http:// base URL.
# DTCOM_COOKIE_SECURE=true

# Listen address. Default ":8080".
# DTCOM_LISTEN_ADDR=:8080

# Log verbosity: debug | info | warn | error. Default "info".
# DTCOM_LOG_LEVEL=info

# Directory overrides. Defaults are relative to the working directory.
# DTCOM_CONTENT_DIR=content
# DTCOM_STATIC_DIR=static
# DTCOM_PUBLIC_DIR=public
# DTCOM_TEMPLATES_DIR=templates
# DTCOM_DATA_DIR=data

# --- docker compose only ----------------------------------------------------

# Host interface the published port binds to. Default 127.0.0.1 (reachable
# only through a local proxy/tunnel). Use 0.0.0.0 to publish it directly.
# DTCOM_BIND=127.0.0.1

# Host port the container's 8080 is published on. Default 8080. Change it when
# something else on the host already holds that port; the container always
# listens on 8080 internally, so DTCOM_LISTEN_ADDR does not need to move with it.
# DTCOM_PORT=8080

# uid:gid the container runs as. Must be able to write ./content on the host.
# Default 65532 (the distroless "nonroot" user). Usually: id -u / id -g.
# DTCOM_UID=1000
# DTCOM_GID=1000
