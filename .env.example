# Canonical site URL (used for SEO, RSS, OG tags, sitemap)
DTCOM_BASE_URL=https://davidtorcivia.com

# Admin password as a bcrypt hash. Generate with:
#   htpasswd -BbnC 10 "" "yourpassword" | cut -d: -f2
# (the hash must include the $2a$/$2b$ prefix)
DTCOM_ADMIN_PASSWORD_HASH=

# TOTP shared secret (base32). Generate a 20-byte secret and base32-encode it,
# e.g. with Python: python3 -c "import base64,os;print(base64.b32encode(os.urandom(20)).decode())"
# Add it to your authenticator app (Google Authenticator, 1Password, etc.) as a
# TOTP key — the label doesn't matter, just the secret.
DTCOM_TOTP_SECRET=

# HMAC key for signing admin session cookies. Generate with: openssl rand -hex 32
DTCOM_SESSION_KEY=

# Bearer token for the REST API (/api/v1/*) and MCP server (/mcp).
# Generate with: openssl rand -hex 24
DTCOM_API_TOKEN=

# RSS poller interval (Go duration syntax). Default 30m.
DTCOM_RSS_INTERVAL=30m
